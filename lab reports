# Program: Ohm's Law Calculator
# Description: Calculates Current (I) based on Voltage (V) and Resistance (R)

# 1. Input Section
voltage = float(input("Enter voltage (V): "))
resistance = float(input("Enter resistance (Ohms): "))

# 2. Logic & Calculation Section
if resistance != 0:
    # Ohm's Law: I = V / R
    current = voltage / resistance
    
    # 3. Output Section (Rounded to 2 decimal places for clarity)
    print(f"Current (A): {current:.2f}")
else:
    # Error Handling for division by zero
    print("Error: Resistance cannot be zero.")



#lab 2 report
import numpy as np
import matplotlib.pyplot as plt

# 1. Circuit Constants
R = 1000    # Resistance in Ohms
C = 1e-6    # Capacitance in Farads (1 microFarad)
V = 5       # Source Voltage in Volts

# 2. Time Array
# Creates 1000 points between 0 and 0.01 seconds
t = np.linspace(0, 0.01, 1000)

# 3. Charging Equation
# Vc = V * (1 - e^(-t / RC))
Vc = V * (1 - np.exp(-t / (R * C)))

# 4. Plotting the Results
plt.plot(t, Vc)
plt.xlabel("Time (s)")
plt.ylabel("Voltage (V)")
plt.title("RC Charging Curve")
plt.grid(True) # Added for better report readability
plt.show()




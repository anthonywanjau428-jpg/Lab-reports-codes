# Lab 2 (Module 7): Blockchain Simulation
import hashlib

def hash_block(block):
    return hashlib.sha256(block.encode()).hexdigest()

genesis = "Block 0: Genesis"
block1 = "Block 1 after " + hash_block(genesis)
block2 = "Block 2 after " + hash_block(block1)

print(genesis)
print(block1)
print(block2)




# Lab 3 (Module 7): Linear Regression
import numpy as np
from sklearn.linear_model import LinearRegression

# Training data (Size in sq ft, Price in $)
X = np.array([[1000], [1500], [2000], [2500], [3000]])
y = np.array([200000, 250000, 310000, 360000, 400000])

model = LinearRegression()
model.fit(X, y)

# Predict price for a 2200 sq ft house
prediction = model.predict([[2200]])
print(f"Predicted price for 2200 sq ft: ${prediction[0]:.2f}")

import random, time
import matplotlib.pyplot as plt

# 1. Initialize data storage
temps = []

# 2. Data Acquisition Loop (10 iterations)
for t in range(10):
    # Simulate a temperature reading around 25°C (+/- 1 degree)
    temp = 25 + random.uniform(-1, 1)
    temps.append(temp)
    
    # 3. File Logging: Append data to a CSV file
    with open("temps.csv", "a") as f:
        f.write(f"{t},{temp}\n")
        
    # Simulate a time delay between readings
    time.sleep(0.5)

# 4. Visualization Section
plt.plot(temps)
plt.xlabel("Time (s)")
plt.ylabel("Temperature (C)")
plt.title("Temperature Log")
plt.show()


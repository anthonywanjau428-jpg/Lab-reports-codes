# Lab 1: Ohm’s Law Calculator
try:
    while True:
        voltage = float(input("Enter voltage (V): "))
        resistance = float(input("Enter resistance (Ohms): "))

        if resistance != 0:
            current = voltage / resistance
            power = voltage * current # Extension: Calculate Power (P = V * I)
            print(f"Current (A): {current:.2f}")
            print(f"Power (W): {power:.2f}")
        else:
            print("Error: Resistance cannot be zero")
        
        cont = input("Do another calculation? (y/n): ")
        if cont.lower() != 'y':
            break
except ValueError:
    print("Invalid input! Please enter numeric values.")


# Lab 2: RC Circuit Simulation
import numpy as np
import matplotlib.pyplot as plt

# Constants
R = 1000   # Resistance in Ohms
C = 1e-6   # Capacitance in Farads
V = 5      # Source Voltage
t = np.linspace(0, 0.01, 1000)

# Simulate Discharging (Vc = V * e^(-t/RC))
vc_discharging = V * np.exp(-t / (R * C))

plt.plot(t, vc_discharging)
plt.xlabel("Time (s)")
plt.ylabel("Capacitor Voltage (V)")
plt.title("Capacitor Discharging Simulation")
plt.grid(True)
plt.show()



# Lab 3: Data Logging and Plotting
import random, time
import matplotlib.pyplot as plt

temps = []
try:
    for t in range(10): 
        temp = 25 + random.uniform(-1, 1)
        temps.append(temp)
        
        # Log to CSV file
        with open("temps.csv", "a") as f:
            f.write(f"{t},{temp:.2f}\n")
        
        time.sleep(0.5)

    plt.plot(temps)
    plt.xlabel("Time (s)")
    plt.ylabel("Temperature (C)")
    plt.title("Temperature Log")
    plt.show()
except IOError:
    print("Error: Could not write to file.")





